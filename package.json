{
  "name": "scratch-gallery",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "A minimal Vue 3 gallery for packaged Scratch games.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-site.mjs",
    "test:security": "node --test scripts/security.test.mjs",
    "test:maintenance": "node --test scripts/maintenance.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check:live": "node scripts/check-live.mjs",
    "verify": "npm run audit:catalog && npm run audit:assets && npm run check && npm run test:security && npm run test:maintenance && npm run test:activities && npm run test:works && npm run test:voting && npm run build && node scripts/check-output.mjs && npm run test:activity-render && npm run test:catalog-render",
    "verify:local": "node scripts/verify-local.mjs",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "audit:assets": "node scripts/audit-assets.cjs",
    "capture-previews": "node scripts/capture-previews.cjs",
    "import-game": "node scripts/import-game.cjs",
    "optimize:games": "node scripts/optimize-game-package.cjs",
    "migrate:game-ids": "node scripts/migrate-game-ids.cjs",
    "register:creator": "node scripts/register-creator.cjs",
    "release:mark": "node scripts/mark-published.cjs",
    "audit:catalog": "node scripts/audit-catalog.cjs",
    "test:activities": "node --test scripts/activity.test.mjs",
    "firebase:initialize": "node scripts/firebase-initialize.mjs",
    "test:activity-render": "node scripts/test-activity-render.mjs",
    "test:works": "node --test scripts/work.test.mjs",
    "test:catalog-render": "node scripts/test-catalog-render.mjs",
    "firebase:catalog": "node scripts/firebase-catalog.mjs",
    "test:voting": "node --test scripts/voting.test.mjs",
    "voting:prepare": "node scripts/voting-prepare.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@netlify/functions": "^6.0.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@turbowarp/jszip": "3.12.0",
    "@turbowarp/packager": "3.13.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
