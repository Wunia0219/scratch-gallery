# Copy to .env.local; never commit credentials. Existing site stays in legacy mode until setup is verified.
ACTIVITY_DATA_MODE=legacy
FIREBASE_PROJECT_ID=scratch-gallery-c0e33
FIREBASE_ENVIRONMENT=production
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# Local only: absolute path to a service-account JSON stored outside public/ and Git.
GOOGLE_APPLICATION_CREDENTIALS=
